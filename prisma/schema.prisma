generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id       String             @id
  name     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  trades   TradeRecord[]
  thoughts ThoughtRecord[]
  dcaEntries DcaRecord[]
  dcaSyncSettings DcaSyncSetting[]
  checkinTasks CheckinTaskItem[]
  checkinTaskChecks CheckinTaskDailyCheck[]
  setting  PortfolioSetting?
}

model TradeRecord {
  id           String   @id
  profileId    String
  ticker       String
  name         String?
  pricingMode  String?
  binanceMarketType String?
  binanceSymbol String?
  direction    String
  status       String
  assetClass   String
  currency     String
  entryDate    String
  exitDate     String?
  entryPrice   Float
  exitPrice    Float?
  currentPrice Float?
  quantity     Float
  fees         Float
  setupType    String?
  tagsJson     String
  notes        String?
  createdAt    String
  updatedAt    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([profileId, exitDate])
  @@index([profileId, updatedAt])
}

model ThoughtRecord {
  id         String   @id
  profileId  String
  title      String
  content    String
  category   String
  tagsJson   String
  ticker     String?
  isPrivate  Boolean  @default(false)
  createdAt  String
  updatedAt  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category])
  @@index([profileId, updatedAt])
}

model DcaRecord {
  id             String   @id
  profileId      String
  ticker         String
  name           String?
  side           String?
  assetClass     String
  currency       String
  investedAt     String
  investedAmount Float
  quantity       Float
  currentPrice   Float?
  quoteSymbol    String?
  quoteCurrency  String?
  priceUpdatedAt String?
  source         String?
  sourceAddress  String?
  externalId     String?
  sourceUpdatedAt String?
  notes          String?
  createdAt      String
  updatedAt      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, assetClass])
  @@index([profileId, source, sourceAddress])
  @@index([profileId, updatedAt])
}

model PortfolioSetting {
  profileId      String   @id
  initialCapital Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DcaSyncSetting {
  profileId    String
  provider     String
  address      String
  lastSyncedAt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, provider])
}

model LoginRateLimit {
  clientKey    String @id
  count        Int
  windowStart  Int
  blockedUntil Int
}

model CheckinTaskItem {
  id        String   @id
  profileId String
  title     String
  content   String
  status    String
  createdAt String
  updatedAt String
  endedAt   String?
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checks    CheckinTaskDailyCheck[]

  @@index([profileId, status])
  @@index([profileId, updatedAt])
}

model CheckinTaskDailyCheck {
  id        String   @id
  profileId String
  taskId    String
  date      String
  checkedAt String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task      CheckinTaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([profileId, date])
  @@index([taskId, date])
}
